{
  "permissions": {
    "allow": [
      "Bash(python C:/Users/example/.claude/_shared/**)",
      "Bash(git fetch *)",
      "mcp__plugin_github_github__pull_request_read",
      "mcp__serena__read_file"
    ]
  },
  "worktree": {
    "bgIsolation": "none"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/session_start_refresh.py || python .claude/hooks/session_start_refresh.py",
            "timeout": 630
          }
        ]
      }
    ]
  }
}
