{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/control_blocker.py", "timeout": 20},
          {"type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/exit_two_blocker.py", "timeout": 20},
          {"type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/never_blocks.py", "timeout": 20},
          {"type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/overblocker.py", "timeout": 20},
          {"type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/crashing.py", "timeout": 20}
        ]
      }
    ]
  }
}
