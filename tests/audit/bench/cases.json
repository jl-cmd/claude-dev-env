  "defaults": {
    "repetitions": {
      "initial": 5,
      "escalated_total": 10,
      "escalate_when": "the pass-rate delta falls outside the no-material-difference band but below the decisive delta, or the two arms disagree on any primary grader in fewer than 2 runs apart, or any row ended in a harness or session error (that row is rerun, at most 2 reruns, and never counted)"
    },
    "acceptance": {
      "default": {
        "unit": "a run passes when every primary grader passes; the arm score is the pass rate over counted runs",
        "minimum_quality": "full-cde pass rate at or above 0.60, otherwise the case cannot support a KEEP",
        "no_material_difference_band": "absolute pass-rate delta at or below 0.20",
        "decisive_delta": "absolute pass-rate delta at or above 0.40 at 5 runs, or above 0.20 at 10 runs",
        "cost_band": "median tokens within 15 percent and median wall_seconds within 20 percent count as no material cost difference",
        "after_escalation": "a delta still inside the band, or still inconsistent, reads as no proven contribution"
      },
      "cost-led": {
        "unit": "same pass rule as default",
        "minimum_quality": "both arms at or above 0.80 pass rate",
        "no_material_difference_band": "absolute pass-rate delta at or below 0.20 and median tokens within 15 percent",
        "decisive_delta": "median tokens differ by 30 percent or more with quality inside the band",
        "cost_band": "median tokens within 15 percent",
        "after_escalation": "same as default"
      },
      "judgment-led": {
        "unit": "deterministic primary graders gate the run; a judge from a different model family scores the rubric 1 to 5, blind to the arm",
        "minimum_quality": "full-cde mean rubric score at or above 3.5",
        "no_material_difference_band": "mean rubric delta at or below 0.5 and gate pass-rate delta at or below 0.20",
        "decisive_delta": "mean rubric delta at or above 1.0",
        "cost_band": "same as default",
        "after_escalation": "same as default"
      }
    }
  },
